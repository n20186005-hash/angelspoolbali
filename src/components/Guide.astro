---
import data from '../data/guide.json';import Layout from './Layout.astro';
interface Props { locale:'id'|'en'; }
const {locale}=Astro.props;const d=data.copy[locale];const sources=data.sources;const en=locale==='en';
const schema={'@context':'https://schema.org','@type':'TouristAttraction','@id':'https://angelspoolbali.com/#place','name':'Angel’s Billabong','description':d.description,'url':'https://angelspoolbali.com'+(en?'/en/':'/'),'geo':{'@type':'GeoCoordinates',latitude:-8.7335003,longitude:115.4489788},'address':{'@type':'PostalAddress',addressLocality:'Nusa Penida',addressRegion:'Bali',addressCountry:'ID'},'image':'https://angelspoolbali.com/images/billabong.webp'};
const faq={'@context':'https://schema.org','@type':'FAQPage',mainEntity:d.faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Layout locale={locale} title={d.title} description={d.description}><main id="main"><section class="hero"><div><p class="eyebrow">Nusa Penida · Klungkung · Bali</p><h1>{d.h1}</h1><p>{d.intro}</p><a class="button" href="#safety">{d.nav[1]}</a> <a class="button secondary" href={sources.maps}>Google Maps ↗</a></div><figure><img src="/images/billabong.webp" alt={d.photoAlt} width="1600" height="900" fetchpriority="high"/><figcaption><a href="https://commons.wikimedia.org/wiki/File:Angel%27s_Billabong,_Nusa_Penida.jpg">Georgi Kovachev · Wikimedia Commons</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a><p>{d.photoCaption}</p></figcaption></figure></section><p class="callout">{d.notice}</p><p class="eyebrow">{d.updated}</p>{d.sections.map(([id,h,p,key])=><section id={id}><h2>{h}</h2><p>{p}</p><a href={sources[key as keyof typeof sources]}>{en?'Source':'Sumber'} ↗</a></section>)}<section id="faq"><h2>{en?'Questions before visiting':'Pertanyaan sebelum berkunjung'}</h2>{d.faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section><section id="sources"><h2>{en?'Public sources & limits':'Sumber publik & batas informasi'}</h2><p>{en?'Use dated reports for their stated scope. A road plan, inspection or old photograph does not establish current access.':'Gunakan laporan bertanggal sesuai lingkupnya. Rencana jalan, pemeriksaan, atau foto lama tidak membuktikan akses sekarang.'}</p><ul><li><a href={sources.barriers}>Dinas Pariwisata Klungkung — {en?'warning signs and barriers inspection (2025)':'pemeriksaan papan peringatan dan pagar (2025)'}</a></li><li><a href={sources.place}>Kecamatan Nusa Penida — Sekilas Tentang Nusa Penida</a></li><li><a href={sources.road}>Pemkab Klungkung — {en?'road widening survey (2025)':'survei pelebaran jalan (2025)'}</a></li><li><a href={sources.levy}>JDIH Klungkung — Peraturan Daerah No. 4 Tahun 2026</a> ({en?'tax and levy document index; not a quoted current admission price':'indeks peraturan pajak dan retribusi; bukan kutipan tarif masuk terkini'})</li><li><a href={sources.maps}>Google Maps — Angel’s Billabong</a></li></ul><p>{d.updated}.</p></section></main><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/><script is:inline type="application/ld+json" set:html={JSON.stringify(faq)}/></Layout>
