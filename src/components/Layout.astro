---
import data from '../data/guide.json';
interface Props { locale: 'id'|'en'; page?: 'home'|'privacy'|'terms'|'cookie'; title: string; description: string; noIndex?: boolean; }
const {locale,page='home',title,description,noIndex=false}=Astro.props;
const d=data.copy[locale], en=locale==='en',home=en?'/en/':'/',route=home+(page==='home'?'':page+'/'),pair=(en?'/':'/en/')+(page==='home'?'':page+'/');
const canonical=new URL(route,Astro.site).href;
const ids=['location','safety','visit','travel','faq','sources'];
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#163a48"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={noIndex?'noindex,follow':'index,follow,max-image-preview:large'}/>{!noIndex&&<><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="id" href={new URL((en?pair:route),Astro.site).href}/><link rel="alternate" hreflang="en" href={new URL((en?route:pair),Astro.site).href}/><link rel="alternate" hreflang="x-default" href={new URL((en?pair:route),Astro.site).href}/></>}<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/>{!noIndex&&<meta property="og:url" content={canonical}/>}<meta property="og:image" content={new URL('/images/billabong.webp',Astro.site).href}/><meta property="og:image:alt" content={d.photoAlt}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><link rel="icon" href="/favicon.svg"/><link rel="stylesheet" href="/guide.css"/></head><body><a class="skip" href="#main">{en?'Skip to content':'Lewati ke konten'}</a><header><div class="brand"><a href={home}>Angel’s Billabong <small>{en?'Independent coastal guide':'Panduan pesisir independen'}</small></a><a class="language" lang={en?'id':'en'} href={pair}>{en?'Bahasa Indonesia':'English'}</a></div><nav aria-label={en?'Main navigation':'Navigasi utama'}>{ids.map((id,i)=><a href={home+'#'+id}>{d.nav[i]}</a>)}</nav></header><slot/><aside id="cookie-banner" class="cookie-banner hidden" aria-label={en?'Cookie choices':'Pilihan kuki'}><p>{d.banner} <a href={home+'cookie/'}>{d.manage}</a></p><button type="button" data-cookie-reject>{d.reject}</button> <button type="button" data-cookie-accept>{d.allow}</button><p data-consent-status role="status" aria-live="polite"></p></aside><footer><p>{d.footer}</p><div class="footerlinks">{(['privacy','terms','cookie'] as const).map(key=><a href={home+key+'/'}>{d.legal[key][0]}</a>)}</div><p>© 2026 Angel’s Billabong Guide</p></footer><script is:inline src="/js/consent.js" defer></script><script is:inline src="/js/retire-offline.js" defer></script></body></html>
